# Environnement de test (tests et commandes lancées avec --env=testing) : copier en .env.testing (non commité)
# et renseigner APP_KEY (php artisan key:generate --env=testing) et DB_PASSWORD.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# Base de test : son nom doit se terminer par « _test » (garde-fou App\Support\GardeFouBase).
DB_DATABASE=raaga_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RAAGA_DEMO=false
RAAGA_TOTP_FACULTATIF_EN_LOCAL=false
RAAGA_DUREE_CONTRAT_ANNEES=5
RAAGA_CLE_PORTIQUES=
# Vérifications de cartes par minute et par adresse IP (QR code et portiques).
RAAGA_CARTES_TENTATIVES=30
# Agents connectés avec le droit cartes.verifier : vérifications par minute et par compte.
RAAGA_CARTES_TENTATIVES_AGENTS=300
# Proxys de confiance (Nginx en proxy inverse) : l'adresse du visiteur est lue dans X-Forwarded-For.
RAAGA_PROXYS_DE_CONFIANCE=127.0.0.1,::1

# Rendu des cartes (Chrome sans interface) : chemin du binaire Chrome ou Chromium. Sans Chrome, les tests de rendu sont ignorés.
RAAGA_CHROME_BINAIRE=chrome
