# Environnement de recette (tests du comité technique, réunion du 05/11/2026). Copier en .env sur le serveur de recette,
# séparé de la production : base, stockage et domaine propres. Clé et mots de passe à générer sur place, jamais ici.
APP_NAME=Raaga
APP_ENV=recette
APP_KEY=
APP_DEBUG=false
APP_URL=https://recette.exemple.invalid

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base de recette distincte de la production (jamais la base « raaga »).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raaga_recette
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aucun courriel réel : écrits dans les journaux.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="recette@exemple.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Mode test : bandeau « ENVIRONNEMENT DE TEST » sur toutes les pages (APP_ENV=recette), paiements par le simulateur,
# SMS écrits dans les journaux et lisibles sur la page « SMS envoyés » (/recette/sms).
RAAGA_DEMO=false
RAAGA_PAIEMENT_FOURNISSEUR=simule
RAAGA_SMS_PILOTE=log
RAAGA_SMS_JOURNAL_RECETTE=true
# Mot de passe commun des testeurs pour la page « SMS envoyés » (à choisir sur place ; vide : page fermée).
RAAGA_SMS_MOT_DE_PASSE_RECETTE=
RAAGA_THEME_PUBLIC=lumiere
# Double authentification du back-office : obligatoire, comme en production.
RAAGA_TOTP_FACULTATIF_EN_LOCAL=false
RAAGA_DUREE_CONTRAT_ANNEES=5
RAAGA_CLE_PORTIQUES=
RAAGA_CARTES_TENTATIVES=30
RAAGA_CARTES_TENTATIVES_AGENTS=300
RAAGA_PROXYS_DE_CONFIANCE=127.0.0.1,::1
RAAGA_CHROME_BINAIRE=chromium
